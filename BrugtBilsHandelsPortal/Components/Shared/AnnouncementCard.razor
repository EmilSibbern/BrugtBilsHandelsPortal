@using BrugtBilsHandelsPortal.DTOs.Announcements

<div class="card h-100 shadow-sm">
    <div class="ratio ratio-16x9 bg-light">
        @if (string.IsNullOrWhiteSpace(Announcement.PrimaryImageFileName))
        {
            <div class="d-flex align-items-center justify-content-center text-secondary">
                Intet billede
            </div>
        }
        else
        {
            <img src="@ImageUrl" class="card-img-top object-fit-cover" alt="@Announcement.Title" />
        }
    </div>

    <div class="card-body d-flex flex-column">
        <h2 class="h5 card-title">
            @Announcement.Title
        </h2>

        <p class="text-muted mb-2">
            @Announcement.BrandName
            @Announcement.Model ·
            @Announcement.ProductionYear
        </p>

        <p class="mb-3">
            @($"{Announcement.Mileage:N0} km")
        </p>

        <p class="fs-4 fw-semibold text-primary mt-auto">
            @($"{Announcement.Price:N0} kr.")
        </p>

        <a href="/announcements/@Announcement.Id" class="btn btn-outline-primary">
            Se annonce
        </a>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public AnnouncementListItemDto Announcement { get; set; } = default!;

    private string ImageUrl => $"/uploads/{Uri.EscapeDataString(Announcement.PrimaryImageFileName!)}";
}