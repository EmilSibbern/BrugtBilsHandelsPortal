@page "/announcements/mine"
@attribute [Authorize]
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using BrugtBilsHandelsPortal.DTOs.Announcements
@using BrugtBilsHandelsPortal.Services.Interfaces

@inject IAnnouncementService AnnouncementService

<PageTitle>Mine annoncer</PageTitle>

<div class="container py-4 my-announcements-page">
    <div class="page-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-3 mb-4">
        <div>
            <p class="page-kicker mb-2">Dit bilmarked</p>

            <h1 class="mb-1">Mine annoncer</h1>

            <p class="text-muted mb-0">
                Rediger dine annoncer, og vælg hvilke der skal være synlige.
            </p>
        </div>

        <a href="/announcements/create" class="btn btn-primary flex-shrink-0">
            Opret annonce
        </a>
    </div>

    @if (_isLoading)
    {
        <div class="loading-state" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Indlæser dine annoncer...</span>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success" role="alert">
                @_successMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @_errorMessage
            </div>
        }

        @if (_announcements.Count == 0)
        {
            <div class="empty-state" role="status">
                <div class="empty-state-icon" aria-hidden="true">+</div>
                <h2 class="h4 mb-2">Ingen annoncer endnu</h2>
                <p class="text-muted mb-4">
                    Du har ikke oprettet nogen annoncer endnu.
                </p>
                <a href="/announcements/create" class="btn btn-primary">
                    Opret din første annonce
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var announcement in _announcements)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <article class="card announcement-card h-100 shadow-sm">
                            <div class="ratio ratio-16x9 bg-light announcement-image">
                                @if (string.IsNullOrWhiteSpace(announcement.PrimaryImageFileName))
                                {
                                    <div class="image-placeholder d-flex align-items-center justify-content-center text-secondary">
                                        Intet billede
                                    </div>
                                }
                                else
                                {
                                    <img src="@GetImageUrl(announcement)" class="card-img-top object-fit-cover" alt="@announcement.Title" />
                                }
                            </div>

                            <div class="card-body d-flex flex-column p-4">
                                <div class="d-flex justify-content-between gap-2 mb-2">
                                    <h2 class="h5 card-title mb-0">
                                        @announcement.Title
                                    </h2>

                                    @if (announcement.IsActive)
                                    {
                                        <span class="badge status-badge status-active">
                                            Aktiv
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge status-badge status-inactive">
                                            Inaktiv
                                        </span>
                                    }
                                </div>

                                <p class="text-muted mb-2">
                                    @announcement.BrandName
                                    @announcement.Model ·
                                    @announcement.ProductionYear
                                </p>

                                <p class="mb-2">
                                    @($"{announcement.Mileage:N0} km")
                                </p>

                                <p class="announcement-price fs-4 fw-semibold text-primary mt-auto mb-3">
                                    @($"{announcement.Price:N0} kr.")
                                </p>

                                <div class="d-grid gap-2">
                                    <a href="/announcements/@announcement.Id/edit" class="btn btn-outline-primary">
                                        Rediger annonce
                                    </a>

                                    <button type="button" class="@GetStatusButtonClass(announcement)" disabled="@_isChangingStatus" @onclick="() => ChangeStatusAsync(announcement)">
                                        @(announcement.IsActive ? "Deaktiver annonce" : "Aktiver annonce")
                                    </button>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private IReadOnlyList<AnnouncementListItemDto> _announcements = Array.Empty<AnnouncementListItemDto>();

    private bool _isLoading = true;
    private bool _isChangingStatus;

    private string? _successMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAnnouncementsAsync();
    }

    private async Task LoadAnnouncementsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            // Finder selv brugeren fra login-sessionen.
            _announcements = await AnnouncementService.GetMineAsync();
        }
        catch
        {
            _errorMessage = "Dine annoncer kunne ikke indlæses.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ChangeStatusAsync(AnnouncementListItemDto announcement)
    {
        if (_isChangingStatus)
        {
            return;
        }

        _isChangingStatus = true;
        _successMessage = null;
        _errorMessage = null;

        try
        {
            if (announcement.IsActive)
            {
                await AnnouncementService.DeactivateAsync(announcement.Id);

                _successMessage = "Annoncen er deaktiveret.";
            }
            else
            {
                await AnnouncementService.ActivateAsync(announcement.Id);

                _successMessage = "Annoncen er aktiveret.";
            }

            await LoadAnnouncementsAsync();
        }
        catch (ValidationException exception)
        {
            _errorMessage = exception.Message;
        }
        catch (UnauthorizedAccessException)
        {
            _errorMessage = "Du har ikke adgang til at ændre annoncen.";
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = exception.Message;
        }
        catch
        {
            _errorMessage = "Annoncens status kunne ikke ændres.";
        }
        finally
        {
            _isChangingStatus = false;
        }
    }

    private static string GetImageUrl(AnnouncementListItemDto announcement)
    {
        return $"/uploads/{Uri.EscapeDataString(announcement.PrimaryImageFileName!)}";
    }

    private static string GetStatusButtonClass(AnnouncementListItemDto announcement)
    {
        return announcement.IsActive ? "btn btn-outline-danger" : "btn btn-outline-success";
    }
}
