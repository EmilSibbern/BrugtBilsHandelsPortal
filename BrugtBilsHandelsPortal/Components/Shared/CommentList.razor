@using BrugtBilsHandelsPortal.DTOs.Comments

@if (Comments.Count == 0)
{
    <p class="text-muted" data-testid="comments-empty">
        Der er endnu ingen kommentarer.
    </p>
}
else
{
    <div data-testid="comment-list">
        @foreach (var comment in Comments)
        {
            <article class="card mb-3" data-testid="comment" @key="comment.Id">
                <div class="card-body">
                    <div class="d-flex justify-content-between gap-3 mb-2">
                        <strong>
                            @comment.Username
                        </strong>

                        <time class="text-muted" datetime="@comment.CreatedAt.ToString("O")">
                            @comment.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                        </time>
                    </div>

                    <p class="mb-2" style="white-space: pre-line;">
                        @comment.Text
                    </p>

                    <AuthorizeView>
                        <Authorized>
                            <button type="button" class="btn btn-sm btn-link px-0" data-testid="@($"reply-comment-{comment.Id}")" @onclick="() => StartReply(comment.Id)">
                                Svar
                            </button>
                        </Authorized>

                        <NotAuthorized>
                            <button type="button" class="btn btn-sm btn-link px-0" data-testid="@($"reply-comment-{comment.Id}")" @onclick="RequestLoginAsync">
                                Svar
                            </button>
                        </NotAuthorized>
                    </AuthorizeView>

                    @if (_replyingToCommentId == comment.Id)
                    {
                        <div class="mt-3" data-testid="@($"reply-form-{comment.Id}")">
                            <CommentForm AnnouncementId="AnnouncementId" ParentCommentId="comment.Id" OnCreated="HandleReplyCreatedAsync" OnCancel="CancelReplyAsync" />
                        </div>
                    }
                </div>
            </article>

            @foreach (var reply in comment.Replies)
            {
                <article class="card mb-3 ms-4 border-start border-primary" data-testid="comment-reply" @key="reply.Id">
                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-3 mb-2">
                            <div>
                                <strong>
                                    @reply.Username
                                </strong>

                                <span class="text-muted ms-1">
                                    svarede
                                    @comment.Username
                                </span>
                            </div>

                            <time class="text-muted" datetime="@reply.CreatedAt.ToString("O")">
                                @reply.CreatedAt
                                    .ToLocalTime()
                                    .ToString("dd-MM-yyyy HH:mm")
                            </time>
                        </div>

                        <p class="mb-0" style="white-space: pre-line;">
                            @reply.Text
                        </p>
                    </div>
                </article>
            }
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public int AnnouncementId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<CommentDto> Comments { get; set; } = Array.Empty<CommentDto>();

    [Parameter]
    public EventCallback<CommentDto> OnCreated { get; set; }

    [Parameter]
    public EventCallback OnLoginRequired { get; set; }

    private long? _replyingToCommentId;

    private void StartReply(long commentId)
    {
        _replyingToCommentId = commentId;
    }

    private async Task CancelReplyAsync()
    {
        _replyingToCommentId = null;
        await Task.CompletedTask;
    }

    private async Task HandleReplyCreatedAsync(CommentDto reply)
    {
        _replyingToCommentId = null;
        await OnCreated.InvokeAsync(reply);
    }

    private async Task RequestLoginAsync()
    {
        await OnLoginRequired.InvokeAsync();
    }
}