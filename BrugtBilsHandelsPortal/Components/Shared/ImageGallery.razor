@using BrugtBilsHandelsPortal.DTOs.Images

@if (Images.Count == 0)
{
    <div class="ratio ratio-16x9 bg-light border rounded">
        <div class="d-flex align-items-center justify-content-center text-secondary">
            Intet billede
        </div>
    </div>
}
else
{
    <div>
        <div class="ratio ratio-16x9 bg-light rounded overflow-hidden">
            <img src="@_selectedImage!.Url" alt="Billede af annoncen" class="w-100 h-100 object-fit-cover" />
        </div>

        @if (_selectedImage.IsPrimary)
        {
            <div>
                <span class="badge text-bg-primary mt-3">
                    Primært billede
                </span>
            </div>
        }

        @if (CanManage)
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                @if (!_selectedImage.IsPrimary)
                {
                    <button type="button" class="btn btn-outline-primary" disabled="@(_isSettingPrimary || _isDeleting)" @onclick="SetSelectedAsPrimaryAsync">
                        @(_isSettingPrimary ? "Gemmer..." : "Sæt som primært billede")
                    </button>
                }

                <button type="button" class="btn btn-outline-danger" data-testid="delete-image" disabled="@(_isSettingPrimary || _isDeleting)" @onclick="ShowDeleteConfirmation">
                    Fjern billede
                </button>
            </div>
        }

        @if (_showDeleteConfirmation && _selectedImage is not null)
        {
            <div class="alert alert-warning mt-3" role="alert" data-testid="delete-image-confirmation">
                <p>
                    Er du sikker på, at du vil fjerne dette billede?
                </p>

                @if (_selectedImage.IsPrimary && Images.Count > 1)
                {
                    <p class="mb-2">
                        Et andet billede bliver automatisk valgt som primært.
                    </p>
                }

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-danger" disabled="@_isDeleting" @onclick="DeleteSelectedAsync">
                        @(_isDeleting ? "Fjerner..." : "Ja, fjern billede")
                    </button>

                    <button type="button" class="btn btn-outline-secondary" disabled="@_isDeleting" @onclick="CancelDelete">
                        Annuller
                    </button>
                </div>
            </div>
        }

        @if (Images.Count > 1)
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                @foreach (var image in Images)
                {
                    <button type="button" class="@GetThumbnailClass(image)" @onclick="() => SelectImage(image)" @key="image.Id">
                        <img src="@image.Url" alt="Vis billede" class="w-100 h-100 object-fit-cover" />
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    // Det valgte billede er lokal UI-state.
    // Images fra forælderkomponenten er den autoritative state.
    [Parameter, EditorRequired]
    public IReadOnlyList<AnnouncementImageDto> Images { get; set; } = Array.Empty<AnnouncementImageDto>();

    [Parameter]
    public bool CanManage { get; set; }

    [Parameter]
    public EventCallback<int> OnSetPrimary { get; set; }

    [Parameter]
    public EventCallback<int> OnDelete { get; set; }

    private AnnouncementImageDto? _selectedImage;

    private int? _previousPrimaryImageId;

    private bool _isSettingPrimary;
    private bool _isDeleting;
    private bool _showDeleteConfirmation;

    protected override void OnParametersSet()
    {
        if (Images.Count == 0)
        {
            _selectedImage = null;
            _previousPrimaryImageId = null;
            _showDeleteConfirmation = false;
            return;
        }

        var primaryImage = Images.FirstOrDefault(image => image.IsPrimary) ?? Images.OrderBy(image => image.SortOrder).First();

        var selectedStillExists = _selectedImage is not null && Images.Any(image => image.Id == _selectedImage.Id);

        if (!selectedStillExists || _previousPrimaryImageId != primaryImage.Id)
        {
            _selectedImage = primaryImage;
            _showDeleteConfirmation = false;
        }

        _previousPrimaryImageId = primaryImage.Id;
    }

    private void SelectImage(AnnouncementImageDto image)
    {
        _selectedImage = image;
        _showDeleteConfirmation = false;
    }

    private async Task SetSelectedAsPrimaryAsync()
    {
        if (_selectedImage is null || _selectedImage.IsPrimary || _isSettingPrimary || _isDeleting)
        {
            return;
        }

        _isSettingPrimary = true;

        try
        {
            await OnSetPrimary.InvokeAsync(_selectedImage.Id);
        }
        finally
        {
            _isSettingPrimary = false;
        }
    }

    private void ShowDeleteConfirmation()
    {
        if (_selectedImage is null || _isDeleting)
        {
            return;
        }

        _showDeleteConfirmation = true;
    }

    private void CancelDelete()
    {
        if (_isDeleting)
        {
            return;
        }

        _showDeleteConfirmation = false;
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selectedImage is null || _isDeleting)
        {
            return;
        }

        _isDeleting = true;

        try
        {
            await OnDelete.InvokeAsync(_selectedImage.Id);

            _showDeleteConfirmation = false;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private string GetThumbnailClass(AnnouncementImageDto image)
    {
        const string baseClasses = "btn p-0 overflow-hidden";

        var selectedClass = _selectedImage?.Id == image.Id ? "border-primary border-3" : "border";

        return $"{baseClasses} {selectedClass}";
    }
}