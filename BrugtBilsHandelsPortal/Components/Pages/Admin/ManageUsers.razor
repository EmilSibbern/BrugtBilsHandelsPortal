@page "/admin/users"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer

@using BrugtBilsHandelsPortal.DTOs.Common
@using BrugtBilsHandelsPortal.DTOs.Users
@using BrugtBilsHandelsPortal.Security
@using BrugtBilsHandelsPortal.Services.Interfaces

@inject IAdminUserService AdminUserService
@inject ICurrentUserService CurrentUserService

<PageTitle>Administrér brugere</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h1>Administrér brugere</h1>

        <p class="text-muted">
            Find brugere, se kontostatus og administrér
            deres adgang til portalen.
        </p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <EditForm Model="_search"
                      OnValidSubmit="ApplySearchAsync">
                <DataAnnotationsValidator/>

                <div class="row g-3">
                    <div class="col-12 col-lg-5">
                        <label for="user-search"
                               class="form-label">
                            Søg
                        </label>

                        <InputText id="user-search"
                                   class="form-control"
                                   placeholder="Brugernavn eller e-mail"
                                   @bind-Value="_search.Query"/>

                        <ValidationMessage
                            For="@(() => _search.Query)"/>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="status-filter"
                               class="form-label">
                            Status
                        </label>

                        <InputSelect id="status-filter"
                                     class="form-select"
                                     @bind-Value="_search.IsActive">
                            <option value="">
                                Alle statusser
                            </option>

                            <option value="true">
                                Aktiv
                            </option>

                            <option value="false">
                                Inaktiv
                            </option>
                        </InputSelect>
                    </div>

                    <div class="col-12 col-md-6 col-lg-2">
                        <label for="role-filter"
                               class="form-label">
                            Rolle
                        </label>

                        <InputSelect id="role-filter"
                                     class="form-select"
                                     @bind-Value="_search.Role">
                            <option value="">
                                Alle roller
                            </option>

                            <option value="User">
                                User
                            </option>

                            <option value="Administrator">
                                Administrator
                            </option>
                        </InputSelect>

                        <ValidationMessage
                            For="@(() => _search.Role)"/>
                    </div>

                    <div class="col-12 col-lg-2 d-flex align-items-end">
                        <div class="d-grid gap-2 w-100">
                            <button type="submit"
                                    class="btn btn-primary"
                                    disabled="@IsBusy">
                                Søg
                            </button>

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    disabled="@IsBusy"
                                    @onclick="ResetSearchAsync">
                                Nulstil
                            </button>
                        </div>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(
        _successMessage))
    {
        <div class="alert alert-success"
             role="status"
             data-testid="admin-user-success">
            @_successMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(
        _errorMessage))
    {
        <div class="alert alert-danger"
             role="alert"
             data-testid="admin-user-error">
            @_errorMessage
        </div>
    }

    @if (_isLoading)
    {
        <p data-testid="admin-users-loading">
            Indlæser brugere...
        </p>
    }
    else if (_page is null ||
             _page.Items.Count == 0)
    {
        <div class="alert alert-info"
             role="status"
             data-testid="admin-users-empty">
            Ingen brugere matcher søgningen.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle"
                   data-testid="admin-users-table">
                <thead>
                <tr>
                    <th scope="col">
                        Brugernavn
                    </th>

                    <th scope="col">
                        E-mail
                    </th>

                    <th scope="col">
                        Rolle
                    </th>

                    <th scope="col">
                        Status
                    </th>

                    <th scope="col">
                        Oprettet
                    </th>

                    <th scope="col">
                        Handling
                    </th>
                </tr>
                </thead>

                <tbody>
                @foreach (var user in _page.Items)
                {
                    <tr data-testid="admin-user-row">
                        <td>
                            @user.Username

                            @if (user.Id == _currentUserId)
                            {
                                <span class="badge text-bg-secondary ms-1">
                                    Dig
                                </span>
                            }
                        </td>

                        <td>
                            @user.Email
                        </td>

                        <td>
                            @user.Role
                        </td>

                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge text-bg-success">
                                    Aktiv
                                </span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">
                                    Inaktiv
                                </span>
                            }
                        </td>

                        <td>
                            @user.CreatedAt.ToString("dd-MM-yyyy")
                        </td>

                        <td>
                            @if (!user.IsActive)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-success"
                                        data-testid="open-reactivate-user"
                                        disabled="@IsBusy"
                                        @onclick="() => OpenReactivateConfirmation(user)">
                                    Genaktivér
                                </button>
                            }
                            else if (user.Id == _currentUserId)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        disabled
                                        title="Du kan ikke deaktivere din egen konto.">
                                    Kan ikke deaktiveres
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        data-testid="open-deactivate-user"
                                        disabled="@IsBusy"
                                        @onclick="() => OpenDeactivateConfirmation(user)">
                                    Deaktivér
                                </button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (_page.TotalPages > 1)
        {
            <nav class="d-flex justify-content-between align-items-center mt-3"
                 aria-label="Sider med brugere">
                <button type="button"
                        class="btn btn-outline-secondary"
                        disabled="@(!_page.HasPreviousPage || IsBusy)"
                        @onclick="PreviousPageAsync">
                    Forrige
                </button>

                <span>
                    Side @_page.Page af @_page.TotalPages
                </span>

                <button type="button"
                        class="btn btn-outline-secondary"
                        disabled="@(!_page.HasNextPage || IsBusy)"
                        @onclick="NextPageAsync">
                    Næste
                </button>
            </nav>
        }
    }

    @if (_userToDeactivate is not null)
    {
        <div class="card border-danger mt-4"
             data-testid="deactivate-user-confirmation">
            <div class="card-body">
                <h2 class="h5">
                    Deaktivér bruger
                </h2>

                <p>
                    Er du sikker på, at du vil deaktivere
                    <strong>@_userToDeactivate.Username</strong>?
                </p>

                <p class="text-muted">
                    Brugeren vil ikke længere kunne logge ind.
                    Handlingen bliver audit-logget.
                </p>

                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-danger"
                            data-testid="confirm-deactivate-user"
                            disabled="@IsBusy"
                            @onclick="ConfirmDeactivateAsync">
                        @if (_isDeactivating)
                        {
                            <span>Deaktiverer...</span>
                        }
                        else
                        {
                            <span>Ja, deaktivér</span>
                        }
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-testid="cancel-deactivate-user"
                            disabled="@IsBusy"
                            @onclick="CloseDeactivateConfirmation">
                        Annuller
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_userToReactivate is not null)
    {
        <div class="card border-success mt-4"
             data-testid="reactivate-user-confirmation">
            <div class="card-body">
                <h2 class="h5">
                    Genaktivér bruger
                </h2>

                <p>
                    Er du sikker på, at du vil genaktivere
                    <strong>@_userToReactivate.Username</strong>?
                </p>

                <p class="text-muted">
                    Brugeren vil igen kunne logge ind.
                    Handlingen bliver audit-logget.
                </p>

                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-success"
                            data-testid="confirm-reactivate-user"
                            disabled="@IsBusy"
                            @onclick="ConfirmReactivateAsync">
                        @if (_isReactivating)
                        {
                            <span>Genaktiverer...</span>
                        }
                        else
                        {
                            <span>Ja, genaktivér</span>
                        }
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-testid="cancel-reactivate-user"
                            disabled="@IsBusy"
                            @onclick="CloseReactivateConfirmation">
                        Annuller
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private AdminUserSearchDto _search =
        new();

    private PagedResult<AdminUserDto>? _page;

    private AdminUserDto? _userToDeactivate;
    private AdminUserDto? _userToReactivate;

    private int? _currentUserId;

    private bool _isLoading = true;
    private bool _isDeactivating;
    private bool _isReactivating;

    private string? _successMessage;
    private string? _errorMessage;

    private bool IsBusy =>
        _isLoading ||
        _isDeactivating ||
        _isReactivating;

    protected override async Task OnInitializedAsync()
    {
        _currentUserId =
            await CurrentUserService.GetUserIdAsync();

        await LoadUsersAsync();
    }

    private async Task ApplySearchAsync()
    {
        _search.Page = 1;
        _successMessage = null;

        await LoadUsersAsync();
    }

    private async Task ResetSearchAsync()
    {
        _search =
            new AdminUserSearchDto();

        _successMessage = null;

        await LoadUsersAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (_page is null ||
            !_page.HasPreviousPage ||
            IsBusy)
        {
            return;
        }

        _search.Page--;

        await LoadUsersAsync();
    }

    private async Task NextPageAsync()
    {
        if (_page is null ||
            !_page.HasNextPage ||
            IsBusy)
        {
            return;
        }

        _search.Page++;

        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result =
                await AdminUserService
                    .SearchAsync(_search);

            if (!result.Succeeded ||
                result.Page is null)
            {
                _page = null;

                _errorMessage =
                    result.ErrorMessage
                    ?? "Brugerne kunne ikke indlæses.";

                return;
            }

            _page = result.Page;
        }
        catch (UnauthorizedAccessException)
        {
            _page = null;

            _errorMessage =
                "Du har ikke adgang til brugeradministration.";
        }
        catch
        {
            _page = null;

            _errorMessage =
                "Brugerne kunne ikke indlæses. Prøv igen.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenDeactivateConfirmation(
        AdminUserDto user)
    {
        if (IsBusy)
        {
            return;
        }

        _successMessage = null;
        _errorMessage = null;
        _userToReactivate = null;
        _userToDeactivate = user;
    }

    private void CloseDeactivateConfirmation()
    {
        if (!_isDeactivating)
        {
            _userToDeactivate = null;
        }
    }

    private async Task ConfirmDeactivateAsync()
    {
        if (_userToDeactivate is null ||
            _isDeactivating ||
            _isReactivating)
        {
            return;
        }

        _isDeactivating = true;
        _successMessage = null;
        _errorMessage = null;

        var targetUsername =
            _userToDeactivate.Username;

        try
        {
            await AdminUserService
                .DeactivateAsync(
                    _userToDeactivate.Id);

            _userToDeactivate = null;

            _successMessage =
                $"Brugeren {targetUsername} er deaktiveret.";

            await LoadUsersAsync();
        }
        catch (UnauthorizedAccessException)
        {
            _errorMessage =
                "Du har ikke adgang til at deaktivere brugere.";
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage =
                exception.Message;
        }
        catch
        {
            _errorMessage =
                "Brugeren kunne ikke deaktiveres. Prøv igen.";
        }
        finally
        {
            _isDeactivating = false;
        }
    }

    private void OpenReactivateConfirmation(
        AdminUserDto user)
    {
        if (IsBusy)
        {
            return;
        }

        _successMessage = null;
        _errorMessage = null;
        _userToDeactivate = null;
        _userToReactivate = user;
    }

    private void CloseReactivateConfirmation()
    {
        if (!_isReactivating)
        {
            _userToReactivate = null;
        }
    }

    private async Task ConfirmReactivateAsync()
    {
        if (_userToReactivate is null ||
            _isReactivating ||
            _isDeactivating)
        {
            return;
        }

        _isReactivating = true;
        _successMessage = null;
        _errorMessage = null;

        var targetUsername =
            _userToReactivate.Username;

        try
        {
            await AdminUserService
                .ReactivateAsync(
                    _userToReactivate.Id);

            _userToReactivate = null;

            _successMessage =
                $"Brugeren {targetUsername} er genaktiveret.";

            await LoadUsersAsync();
        }
        catch (UnauthorizedAccessException)
        {
            _errorMessage =
                "Du har ikke adgang til at genaktivere brugere.";
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage =
                exception.Message;
        }
        catch
        {
            _errorMessage =
                "Brugeren kunne ikke genaktiveres. Prøv igen.";
        }
        finally
        {
            _isReactivating = false;
        }
    }
}