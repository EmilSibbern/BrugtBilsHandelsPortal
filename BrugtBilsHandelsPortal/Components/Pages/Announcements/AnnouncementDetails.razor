@page "/announcements/{Id:int}"
@rendermode InteractiveServer

@using BrugtBilsHandelsPortal.Components.Modals
@using BrugtBilsHandelsPortal.Components.Shared
@using BrugtBilsHandelsPortal.DTOs.Announcements
@using BrugtBilsHandelsPortal.DTOs.Comments
@using BrugtBilsHandelsPortal.DTOs.Images
@using BrugtBilsHandelsPortal.DTOs.Messages
@using BrugtBilsHandelsPortal.Security
@using BrugtBilsHandelsPortal.Services.Interfaces

@inject IAnnouncementService AnnouncementService
@inject IImageService ImageService
@inject ICurrentUserService CurrentUserService
@inject ICommentService CommentService

<PageTitle>@PageTitle</PageTitle>

<div class="container py-4">
    @if (_isLoading)
    {
        <p>Indlæser annonce...</p>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @_errorMessage
        </div>

        <a href="/" class="btn btn-outline-secondary">
            Tilbage til forsiden
        </a>
    }
    else if (_announcement is null)
    {
        <div class="alert alert-warning" role="alert">
            Annoncen findes ikke eller er ikke længere aktiv.
        </div>

        <a href="/" class="btn btn-outline-secondary">
            Tilbage til forsiden
        </a>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_actionSuccessMessage))
        {
            <div class="alert alert-success" role="status" data-testid="deactivate-success">
                @_actionSuccessMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_actionErrorMessage))
        {
            <div class="alert alert-danger" role="alert" data-testid="deactivate-error">
                @_actionErrorMessage
            </div>
        }

        @if (!_announcement.IsActive)
        {
            <div class="alert alert-secondary" role="status" data-testid="inactive-announcement">
                Denne annonce er deaktiveret og vises
                ikke længere offentligt.
            </div>
        }

        <div class="mb-4">
            <ImageGallery Images="_images"/>
        </div>

        <div class="row g-4">
            <div class="col-12 col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h1 class="card-title">
                            @_announcement.Title
                        </h1>

                        <p class="fs-3 fw-semibold text-primary">
                            @FormatPrice(_announcement.Price)
                        </p>

                        <p class="card-text" style="white-space: pre-line;">
                            @_announcement.Description
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h2 class="h4">
                            Biloplysninger
                        </h2>

                        <dl class="row mb-0">
                            <dt class="col-5">
                                Mærke
                            </dt>

                            <dd class="col-7">
                                @_announcement.BrandName
                            </dd>

                            <dt class="col-5">
                                Model
                            </dt>

                            <dd class="col-7">
                                @_announcement.Model
                            </dd>

                            <dt class="col-5">
                                Årgang
                            </dt>

                            <dd class="col-7">
                                @_announcement.ProductionYear
                            </dd>

                            <dt class="col-5">
                                Kilometer
                            </dt>

                            <dd class="col-7">
                                @FormatMileage(
                                    _announcement.Mileage)
                            </dd>

                            <dt class="col-5">
                                Farve
                            </dt>

                            <dd class="col-7">
                                @DisplayValue(
                                    _announcement.Color)
                            </dd>
                        </dl>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body">
                        <h2 class="h4">
                            Sælger
                        </h2>

                        <p class="mb-2">
                            @_announcement.SellerUsername
                        </p>

                        <small class="text-muted">
                            Oprettet
                            @_announcement.CreatedAt.ToString("dd-MM-yyyy")
                        </small>

                        <div class="d-grid gap-2 mt-3">
                            @if (_canEditAnnouncement)
                            {
                                <a href="@($"/announcements/{Id}/edit")" class="btn btn-outline-primary" data-testid="edit-announcement">
                                    Rediger annonce
                                </a>
                            }

                            @if (_isOwner && _announcement.IsActive)
                            {
                                <button type="button" class="btn btn-outline-danger" data-testid="deactivate-announcement" disabled="@_isDeactivating" @onclick="ShowDeactivateConfirmation">
                                    Deaktivér annonce
                                </button>
                            }

                            @if (_showDeactivateConfirmation)
                            {
                                <div class="border border-danger rounded p-3" data-testid="deactivate-confirmation">
                                    <p class="mb-3">
                                        Er du sikker på, at du vil
                                        deaktivere annoncen? Den vil
                                        ikke længere være synlig i den
                                        offentlige oversigt.
                                    </p>

                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-danger" data-testid="confirm-deactivate" disabled="@_isDeactivating" @onclick="HandleDeactivateAsync">
                                            @if (_isDeactivating)
                                            {
                                                <span>
                                                    Deaktiverer...
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    Ja, deaktivér
                                                </span>
                                            }
                                        </button>

                                        <button type="button" class="btn btn-outline-secondary" data-testid="cancel-deactivate" disabled="@_isDeactivating" @onclick="HideDeactivateConfirmation">
                                            Annuller
                                        </button>
                                    </div>
                                </div>
                            }

                            @if (_announcement.IsActive)
                            {
                                <AuthorizeView>
                                    <Authorized>
                                        @if (!_isOwner)
                                        {
                                            <button type="button" class="btn btn-primary" data-testid="contact-seller" @onclick="StartContact">
                                                Kontakt sælger
                                            </button>
                                        }

                                        <div data-testid="comment-form">
                                            <CommentForm AnnouncementId="Id" OnCreated="HandleCommentCreatedAsync"/>
                                        </div>
                                    </Authorized>

                                    <NotAuthorized>
                                        <button type="button" class="btn btn-primary" data-testid="contact-seller" @onclick="OpenLoginRegisterModal">
                                            Kontakt sælger
                                        </button>

                                        <button type="button" class="btn btn-outline-primary" data-testid="add-comment" @onclick="OpenLoginRegisterModal">
                                            Skriv kommentar
                                        </button>
                                    </NotAuthorized>
                                </AuthorizeView>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (_announcement.IsActive)
        {
            <section class="mt-4" data-testid="public-comments">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h2 class="h4">
                            Kommentarer
                        </h2>

                        <CommentList AnnouncementId="Id" Comments="_comments" OnCreated="HandleCommentCreatedAsync" OnLoginRequired="OpenLoginRegisterModal"/>
                    </div>
                </div>
            </section>
        }

        <AuthorizeView Roles="Administrator">
            <div class="mt-4" data-testid="admin-announcement-actions">
                <div class="card border-warning">
                    <div class="card-body">
                        <h2 class="h4">
                            Administration af annonce
                        </h2>

                        <p class="text-muted">
                            Administratorhandlinger til annoncen
                            placeres her.
                        </p>
                    </div>
                </div>
            </div>

            <div class="mt-4" data-testid="admin-comment-actions">
                <div class="card border-warning">
                    <div class="card-body">
                        <h2 class="h4">
                            Moderation af kommentarer
                        </h2>

                        <p class="text-muted">
                            Administratorhandlinger til kommentarer
                            placeres her.
                        </p>
                    </div>
                </div>
            </div>
        </AuthorizeView>

        @if (_showLoginRegisterModal)
        {
            <div data-testid="login-register-modal">
                <LoginRegisterModal OnClose="CloseLoginRegisterModal"/>
            </div>
        }

        @if (_showContactMessage)
        {
            <ContactSellerForm AnnouncementId="Id" OnSent="HandleMessageSent" OnCancel="CloseContactForm"/>
        }
    }
</div>

@code {

    // Route-parameteren kan ændres uden at komponenten
    // genskabes, så state nulstilles ved hvert opslag.
    [Parameter] public int Id { get; set; }

    private AnnouncementDetailsDto? _announcement;

    private IReadOnlyList<AnnouncementImageDto> _images = Array.Empty<AnnouncementImageDto>();

    private IReadOnlyList<CommentDto> _comments = Array.Empty<CommentDto>();

    private bool _isLoading = true;
    private bool _canEditAnnouncement;
    private bool _isOwner;
    private bool _showLoginRegisterModal;
    private bool _showContactMessage;
    private bool _showDeactivateConfirmation;
    private bool _isDeactivating;

    private string? _errorMessage;
    private string? _actionSuccessMessage;
    private string? _actionErrorMessage;

    private string PageTitle => _announcement?.Title ?? "Annonce";

    protected override async Task OnParametersSetAsync()
    {
        // Undgå at vise data fra den forrige annonce,
        // mens den nye indlæses.
        _isLoading = true;
        _errorMessage = null;
        _actionSuccessMessage = null;
        _actionErrorMessage = null;
        _announcement = null;
        _images = Array.Empty<AnnouncementImageDto>();
        _comments = Array.Empty<CommentDto>();
        _canEditAnnouncement = false;
        _isOwner = false;
        _showLoginRegisterModal = false;
        _showContactMessage = false;
        _showDeactivateConfirmation = false;
        _isDeactivating = false;

        try
        {
            _announcement = await AnnouncementService.GetDetailsAsync(Id);

            if (_announcement is null)
            {
                return;
            }

            await LoadImagesAsync();

            if (_announcement.IsActive)
            {
                await LoadCommentsAsync();
            }

            var currentUserId = await CurrentUserService.GetUserIdAsync();

            // UI-rettigheden er kun præsentation;
            // service-laget håndhæver stadig ejerskab.
            _isOwner = currentUserId.HasValue && currentUserId.Value == _announcement.SellerUserId;

            var isAdministrator = await CurrentUserService.IsInRoleAsync("Administrator");

            _canEditAnnouncement = _isOwner || isAdministrator;
        }
        catch
        {
            _errorMessage = "Annoncen kunne ikke indlæses. Prøv igen.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadImagesAsync()
    {
        _images = await ImageService.GetForActiveAnnouncementAsync(Id);
    }

    private async Task LoadCommentsAsync()
    {
        _comments = await CommentService.GetForAnnouncementAsync(Id);
    }

    private async Task HandleCommentCreatedAsync(CommentDto comment)
    {
        // Genindlæs hele tråden, så sortering og
        // serverskabte felter altid er korrekte.
        _comments = await CommentService.GetForAnnouncementAsync(Id);
    }

    private void ShowDeactivateConfirmation()
    {
        _actionErrorMessage = null;
        _actionSuccessMessage = null;
        _showDeactivateConfirmation = true;
    }

    private void HideDeactivateConfirmation()
    {
        if (!_isDeactivating)
        {
            _showDeactivateConfirmation = false;
        }
    }

    private async Task HandleDeactivateAsync()
    {
        if (_isDeactivating)
        {
            return;
        }

        _isDeactivating = true;
        _actionErrorMessage = null;
        _actionSuccessMessage = null;

        try
        {
            await AnnouncementService.DeactivateAsync(Id);

            if (_announcement is not null)
            {
                _announcement.IsActive = false;
            }

            _showDeactivateConfirmation = false;
            _actionSuccessMessage = "Annoncen er deaktiveret og vises ikke længere offentligt.";
        }
        catch (UnauthorizedAccessException exception)
        {
            _actionErrorMessage = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _actionErrorMessage = exception.Message;
        }
        catch
        {
            _actionErrorMessage = "Annoncen kunne ikke deaktiveres. Prøv igen.";
        }
        finally
        {
            _isDeactivating = false;
        }
    }

    private void OpenLoginRegisterModal()
    {
        _showLoginRegisterModal = true;
    }

    private void CloseLoginRegisterModal()
    {
        _showLoginRegisterModal = false;
    }

    private void StartContact()
    {
        _showContactMessage = true;
    }

    private static string FormatPrice(int price)
    {
        return $"{price:N0} kr.";
    }

    private static string FormatMileage(int mileage)
    {
        return $"{mileage:N0} km";
    }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Ikke angivet" : value;
    }

    private void HandleMessageSent(MessageDto message)
    {
        _showContactMessage = false;
    }

    private void CloseContactForm()
    {
        _showContactMessage = false;
    }

}