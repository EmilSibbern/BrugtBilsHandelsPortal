@using BrugtBilsHandelsPortal.DTOs.Messages
@using BrugtBilsHandelsPortal.Services.Interfaces

@inject IMessageService MessageService
@inject ILogger<ContactSellerForm> Logger

<div class="card mt-4"
     data-testid="contact-seller-form">
    <div class="card-body">
        <h2 class="h5">
            Kontakt sælger
        </h2>

        <label for="seller-message"
               class="form-label">
            Besked
        </label>

        <textarea id="seller-message"
                  class="form-control"
                  rows="5"
                  maxlength="2000"
                  disabled="@_isSubmitting"
                  @bind="_messageText"
                  @bind:event="oninput">
        </textarea>

        <div class="form-text"
             aria-live="polite">
            @_messageText.Length / 2000 tegn
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger mt-3"
                 role="alert">
                @_errorMessage
            </div>
        }

        @if (_isSent)
        {
            <div class="alert alert-success mt-3"
                 role="status">
                Beskeden er sendt til sælgeren.
            </div>
        }

        <div class="d-flex gap-2 mt-3">
            <button type="button"
                    class="btn btn-primary"
                    data-testid="send-message"
                    disabled="@CannotSubmit"
                    @onclick="SubmitAsync">
                @(_isSubmitting
                    ? "Sender..."
                    : "Send besked")
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@_isSubmitting"
                    @onclick="CancelAsync">
                Annuller
            </button>
        </div>
    </div>
</div>

@code {
    // Komponenten ejer formular-state, mens forælderen bestemmer, hvornår dialogen vises og lukkes.
    [Parameter, EditorRequired] public int AnnouncementId { get; set; }

    [Parameter] public EventCallback<MessageDto> OnSent { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    private string _messageText = string.Empty;
    private string? _errorMessage;
    private bool _isSubmitting;
    private bool _isSent;

    private bool CannotSubmit =>
        _isSubmitting
        || _isSent
        || string.IsNullOrWhiteSpace(_messageText);

    private async Task SubmitAsync()
    {
        if (CannotSubmit)
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var message = await MessageService.SendAsync(
                new SendMessageDto
                {
                    AnnouncementId = AnnouncementId,
                    Text = _messageText.Trim()
                });

            _messageText = string.Empty;
            _isSent = true;

            await OnSent.InvokeAsync(message);
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Kunne ikke sende besked vedrørende annonce {AnnouncementId}",
                AnnouncementId);

            _errorMessage =
                "Beskeden kunne ikke sendes. Prøv igen.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private Task CancelAsync()
    {
        return OnCancel.InvokeAsync();
    }

}
